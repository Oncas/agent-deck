{
  "id": "catppuccin-latte",
  "name": "Catppuccin Latte",
  "order": 23,
  "css": {
    "--bg": "#eff1f5",
    "--bg-sidebar": "#e6e9ef",
    "--bg-panel": "#eff1f5",
    "--bg-hover": "#dce0e8",
    "--bg-secondary": "#e6e9ef",
    "--bg-primary": "#eff1f5",
    "--border": "#ccd0da",
    "--text": "#4c4f69",
    "--text-dim": "#6c6f85",
    "--accent": "#8839ef",
    "--green": "#40a02b",
    "--red": "#d20f39",
    "--yellow": "#df8e1d",
    "--cyan": "#179299",
    "--magenta": "#ea76cb"
  },
  "terminal": {
    "background": "#eff1f5",
    "foreground": "#4c4f69",
    "cursor": "#dc8a78",
    "selectionBackground": "#acb0be",
    "black": "#5c5f77",
    "red": "#d20f39",
    "green": "#40a02b",
    "yellow": "#df8e1d",
    "blue": "#1e66f5",
    "magenta": "#ea76cb",
    "cyan": "#179299",
    "white": "#acb0be",
    "brightBlack": "#6c6f85",
    "brightRed": "#d20f39",
    "brightGreen": "#40a02b",
    "brightYellow": "#df8e1d",
    "brightBlue": "#1e66f5",
    "brightMagenta": "#ea76cb",
    "brightCyan": "#179299",
    "brightWhite": "#bcc0cc"
  },
  "monaco": {
    "base": "vs",
    "inherit": true,
    "rules": [
      { "token": "comment", "foreground": "6c6f85", "fontStyle": "italic" },
      { "token": "keyword", "foreground": "8839ef" },
      { "token": "string", "foreground": "40a02b" },
      { "token": "number", "foreground": "fe640b" },
      { "token": "type", "foreground": "df8e1d" },
      { "token": "function", "foreground": "1e66f5" },
      { "token": "variable", "foreground": "4c4f69" },
      { "token": "variable.parameter", "foreground": "e64553", "fontStyle": "italic" },
      { "token": "constant", "foreground": "fe640b" },
      { "token": "operator", "foreground": "179299" },
      { "token": "tag", "foreground": "8839ef" },
      { "token": "attribute.name", "foreground": "1e66f5" }
    ],
    "colors": {
      "editor.background": "#eff1f5",
      "editor.foreground": "#4c4f69",
      "editor.lineHighlightBackground": "#e6e9ef",
      "editor.selectionBackground": "#acb0be",
      "editorLineNumber.foreground": "#9ca0b0",
      "editorLineNumber.activeForeground": "#8839ef",
      "editorGutter.background": "#eff1f5",
      "diffEditor.insertedTextBackground": "#40a02b25",
      "diffEditor.removedTextBackground": "#d20f3925",
      "editorWidget.background": "#e6e9ef",
      "editorWidget.border": "#ccd0da",
      "input.background": "#e6e9ef",
      "input.border": "#ccd0da",
      "scrollbarSlider.background": "#ccd0da80"
    }
  }
}
