{
  "id": "light",
  "name": "TokyoNight Light",
  "order": 20,
  "css": {
    "--bg": "#e1e2e7",
    "--bg-sidebar": "#d5d6db",
    "--bg-panel": "#e1e2e7",
    "--bg-hover": "#c8c9d0",
    "--bg-secondary": "#dcdde2",
    "--bg-primary": "#e1e2e7",
    "--border": "#b4b8d0",
    "--text": "#3760bf",
    "--text-dim": "#616880",
    "--accent": "#2e7de9",
    "--green": "#587539",
    "--red": "#f52a65",
    "--yellow": "#8c6c3e",
    "--cyan": "#007197",
    "--magenta": "#9854f1"
  },
  "terminal": {
    "background": "#e1e2e7",
    "foreground": "#3760bf",
    "cursor": "#3760bf",
    "selectionBackground": "#99a7df",
    "black": "#343b59",
    "red": "#c4163a",
    "green": "#3e5c1f",
    "yellow": "#6b5320",
    "blue": "#1a5fb4",
    "magenta": "#7830c4",
    "cyan": "#005a7a",
    "white": "#4e5579",
    "brightBlack": "#515870",
    "brightRed": "#d42050",
    "brightGreen": "#4a6d24",
    "brightYellow": "#7a5b2d",
    "brightBlue": "#2260c0",
    "brightMagenta": "#8640d0",
    "brightCyan": "#006580",
    "brightWhite": "#3760bf"
  },
  "monaco": {
    "base": "vs",
    "inherit": true,
    "rules": [
      { "token": "comment", "foreground": "8990b3", "fontStyle": "italic" },
      { "token": "keyword", "foreground": "2e7de9" },
      { "token": "string", "foreground": "587539" },
      { "token": "number", "foreground": "b15c00" },
      { "token": "type", "foreground": "007197" },
      { "token": "function", "foreground": "2e7de9" },
      { "token": "variable", "foreground": "3760bf" },
      { "token": "constant", "foreground": "b15c00" },
      { "token": "operator", "foreground": "007197" }
    ],
    "colors": {
      "editor.background": "#d5d6db",
      "editor.foreground": "#3760bf",
      "editor.lineHighlightBackground": "#c8c9ce",
      "editor.selectionBackground": "#99a7df",
      "editorLineNumber.foreground": "#8990b3",
      "editorGutter.background": "#d5d6db",
      "diffEditor.insertedTextBackground": "#58753920",
      "diffEditor.removedTextBackground": "#f52a6520",
      "editorWidget.background": "#c8c9ce",
      "editorWidget.border": "#a8aecb",
      "input.background": "#d5d6db",
      "input.border": "#a8aecb",
      "scrollbarSlider.background": "#a8aecb80"
    }
  }
}
