{
  "id": "ayu-mirage",
  "name": "Ayu Mirage",
  "order": 38,
  "css": {
    "--bg": "#161a23",
    "--bg-sidebar": "#1f2430",
    "--bg-panel": "#161a23",
    "--bg-hover": "#2d3a4f",
    "--bg-secondary": "#1b2029",
    "--bg-primary": "#161a23",
    "--border": "#2d3a4f",
    "--text": "#cbccc6",
    "--text-dim": "#707a8c",
    "--accent": "#ffcc66",
    "--green": "#bae67e",
    "--red": "#f28779",
    "--yellow": "#ffd580",
    "--cyan": "#5ccfe6",
    "--magenta": "#d4bfff"
  },
  "terminal": {
    "background": "#161a23",
    "foreground": "#cbccc6",
    "cursor": "#ffcc66",
    "selectionBackground": "#2d3a4f",
    "black": "#161a23",
    "red": "#f28779",
    "green": "#bae67e",
    "yellow": "#ffd580",
    "blue": "#73d0ff",
    "magenta": "#d4bfff",
    "cyan": "#95e6cb",
    "white": "#cbccc6",
    "brightBlack": "#707a8c",
    "brightRed": "#f28779",
    "brightGreen": "#bae67e",
    "brightYellow": "#ffd580",
    "brightBlue": "#73d0ff",
    "brightMagenta": "#d4bfff",
    "brightCyan": "#95e6cb",
    "brightWhite": "#ffffff"
  },
  "monaco": {
    "base": "vs-dark",
    "inherit": true,
    "rules": [
      { "token": "comment", "foreground": "5c6773", "fontStyle": "italic" },
      { "token": "keyword", "foreground": "ffa759" },
      { "token": "string", "foreground": "bae67e" },
      { "token": "number", "foreground": "d4bfff" },
      { "token": "type", "foreground": "73d0ff" },
      { "token": "function", "foreground": "ffd580" },
      { "token": "variable", "foreground": "cbccc6" },
      { "token": "variable.parameter", "foreground": "ffcc66", "fontStyle": "italic" },
      { "token": "constant", "foreground": "d4bfff" },
      { "token": "operator", "foreground": "f29e74" },
      { "token": "tag", "foreground": "5ccfe6" },
      { "token": "attribute.name", "foreground": "ffd580" }
    ],
    "colors": {
      "editor.background": "#161a23",
      "editor.foreground": "#cbccc6",
      "editor.lineHighlightBackground": "#1b2029",
      "editor.selectionBackground": "#2d3a4f",
      "editorLineNumber.foreground": "#3e4b59",
      "editorLineNumber.activeForeground": "#ffcc66",
      "editorGutter.background": "#161a23",
      "diffEditor.insertedTextBackground": "#bae67e25",
      "diffEditor.removedTextBackground": "#f2877925",
      "editorWidget.background": "#1f2430",
      "editorWidget.border": "#2d3a4f",
      "input.background": "#1f2430",
      "input.border": "#2d3a4f",
      "scrollbarSlider.background": "#2d3a4f80"
    }
  }
}
