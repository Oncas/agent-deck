{
  "id": "darcula",
  "name": "Darcula",
  "order": 30,
  "css": {
    "--bg": "#161719",
    "--bg-sidebar": "#1f2022",
    "--bg-panel": "#161719",
    "--bg-hover": "#2e3033",
    "--bg-secondary": "#1c1d1f",
    "--bg-primary": "#161719",
    "--border": "#3a3c3f",
    "--text": "#bcbec4",
    "--text-dim": "#6f737a",
    "--accent": "#cc7832",
    "--green": "#6a8759",
    "--red": "#ff6b68",
    "--yellow": "#ffc66d",
    "--cyan": "#6897bb",
    "--magenta": "#9876aa"
  },
  "terminal": {
    "background": "#161719",
    "foreground": "#bcbec4",
    "cursor": "#bcbec4",
    "selectionBackground": "#214283",
    "black": "#161719",
    "red": "#ff6b68",
    "green": "#6a8759",
    "yellow": "#ffc66d",
    "blue": "#6897bb",
    "magenta": "#9876aa",
    "cyan": "#629755",
    "white": "#a9b7c6",
    "brightBlack": "#5e6063",
    "brightRed": "#ff8785",
    "brightGreen": "#8fbc77",
    "brightYellow": "#ffd687",
    "brightBlue": "#80aacb",
    "brightMagenta": "#b393cc",
    "brightCyan": "#7fb872",
    "brightWhite": "#d4d4d4"
  },
  "monaco": {
    "base": "vs-dark",
    "inherit": true,
    "rules": [
      { "token": "comment", "foreground": "7a7e85", "fontStyle": "italic" },
      { "token": "keyword", "foreground": "cf8e6d", "fontStyle": "bold" },
      { "token": "string", "foreground": "6aab73" },
      { "token": "number", "foreground": "2aacb8" },
      { "token": "type", "foreground": "bcbec4" },
      { "token": "function", "foreground": "56a8f5" },
      { "token": "variable", "foreground": "bcbec4" },
      { "token": "constant", "foreground": "c77dbb" },
      { "token": "operator", "foreground": "bcbec4" },
      { "token": "tag", "foreground": "e8bf6a" },
      { "token": "attribute.name", "foreground": "bababa" }
    ],
    "colors": {
      "editor.background": "#161719",
      "editor.foreground": "#bcbec4",
      "editor.lineHighlightBackground": "#1c1d1f",
      "editor.selectionBackground": "#214283",
      "editorLineNumber.foreground": "#4b5059",
      "editorLineNumber.activeForeground": "#a1a3ab",
      "editorGutter.background": "#161719",
      "diffEditor.insertedTextBackground": "#6aab7330",
      "diffEditor.removedTextBackground": "#ff6b6830",
      "editorWidget.background": "#1f2022",
      "editorWidget.border": "#3a3c3f",
      "input.background": "#1f2022",
      "input.border": "#3a3c3f",
      "scrollbarSlider.background": "#3a3c3f80"
    }
  }
}
