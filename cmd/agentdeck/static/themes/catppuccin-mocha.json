{
  "id": "catppuccin-mocha",
  "name": "Catppuccin Mocha",
  "order": 36,
  "css": {
    "--bg": "#11111b",
    "--bg-sidebar": "#1e1e2e",
    "--bg-panel": "#11111b",
    "--bg-hover": "#313244",
    "--bg-secondary": "#181825",
    "--bg-primary": "#11111b",
    "--border": "#313244",
    "--text": "#cdd6f4",
    "--text-dim": "#7f849c",
    "--accent": "#cba6f7",
    "--green": "#a6e3a1",
    "--red": "#f38ba8",
    "--yellow": "#f9e2af",
    "--cyan": "#94e2d5",
    "--magenta": "#f5c2e7"
  },
  "terminal": {
    "background": "#11111b",
    "foreground": "#cdd6f4",
    "cursor": "#f5e0dc",
    "selectionBackground": "#585b70",
    "black": "#45475a",
    "red": "#f38ba8",
    "green": "#a6e3a1",
    "yellow": "#f9e2af",
    "blue": "#89b4fa",
    "magenta": "#f5c2e7",
    "cyan": "#94e2d5",
    "white": "#bac2de",
    "brightBlack": "#585b70",
    "brightRed": "#f38ba8",
    "brightGreen": "#a6e3a1",
    "brightYellow": "#f9e2af",
    "brightBlue": "#89b4fa",
    "brightMagenta": "#f5c2e7",
    "brightCyan": "#94e2d5",
    "brightWhite": "#a6adc8"
  },
  "monaco": {
    "base": "vs-dark",
    "inherit": true,
    "rules": [
      { "token": "comment", "foreground": "7f849c", "fontStyle": "italic" },
      { "token": "keyword", "foreground": "cba6f7" },
      { "token": "string", "foreground": "a6e3a1" },
      { "token": "number", "foreground": "fab387" },
      { "token": "type", "foreground": "f9e2af" },
      { "token": "function", "foreground": "89b4fa" },
      { "token": "variable", "foreground": "cdd6f4" },
      { "token": "variable.parameter", "foreground": "eba0ac", "fontStyle": "italic" },
      { "token": "constant", "foreground": "fab387" },
      { "token": "operator", "foreground": "94e2d5" },
      { "token": "tag", "foreground": "cba6f7" },
      { "token": "attribute.name", "foreground": "89b4fa" }
    ],
    "colors": {
      "editor.background": "#11111b",
      "editor.foreground": "#cdd6f4",
      "editor.lineHighlightBackground": "#181825",
      "editor.selectionBackground": "#585b70",
      "editorLineNumber.foreground": "#45475a",
      "editorLineNumber.activeForeground": "#cba6f7",
      "editorGutter.background": "#11111b",
      "diffEditor.insertedTextBackground": "#a6e3a125",
      "diffEditor.removedTextBackground": "#f38ba825",
      "editorWidget.background": "#1e1e2e",
      "editorWidget.border": "#313244",
      "input.background": "#1e1e2e",
      "input.border": "#313244",
      "scrollbarSlider.background": "#31324480"
    }
  }
}
