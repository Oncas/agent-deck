{
  "id": "gruvbox-dark",
  "name": "Gruvbox Dark",
  "order": 35,
  "css": {
    "--bg": "#282828",
    "--bg-sidebar": "#1d2021",
    "--bg-panel": "#282828",
    "--bg-hover": "#3c3836",
    "--bg-secondary": "#32302f",
    "--bg-primary": "#282828",
    "--border": "#504945",
    "--text": "#ebdbb2",
    "--text-dim": "#928374",
    "--accent": "#fabd2f",
    "--green": "#b8bb26",
    "--red": "#fb4934",
    "--yellow": "#fabd2f",
    "--cyan": "#8ec07c",
    "--magenta": "#d3869b"
  },
  "terminal": {
    "background": "#282828",
    "foreground": "#ebdbb2",
    "cursor": "#ebdbb2",
    "selectionBackground": "#504945",
    "black": "#282828",
    "red": "#cc241d",
    "green": "#98971a",
    "yellow": "#d79921",
    "blue": "#458588",
    "magenta": "#b16286",
    "cyan": "#689d6a",
    "white": "#a89984",
    "brightBlack": "#928374",
    "brightRed": "#fb4934",
    "brightGreen": "#b8bb26",
    "brightYellow": "#fabd2f",
    "brightBlue": "#83a598",
    "brightMagenta": "#d3869b",
    "brightCyan": "#8ec07c",
    "brightWhite": "#ebdbb2"
  },
  "monaco": {
    "base": "vs-dark",
    "inherit": true,
    "rules": [
      { "token": "comment", "foreground": "928374", "fontStyle": "italic" },
      { "token": "keyword", "foreground": "fb4934" },
      { "token": "string", "foreground": "b8bb26" },
      { "token": "number", "foreground": "d3869b" },
      { "token": "type", "foreground": "fabd2f" },
      { "token": "function", "foreground": "8ec07c", "fontStyle": "bold" },
      { "token": "variable", "foreground": "ebdbb2" },
      { "token": "variable.parameter", "foreground": "fe8019" },
      { "token": "constant", "foreground": "d3869b" },
      { "token": "operator", "foreground": "fe8019" },
      { "token": "tag", "foreground": "8ec07c" },
      { "token": "attribute.name", "foreground": "8ec07c" }
    ],
    "colors": {
      "editor.background": "#282828",
      "editor.foreground": "#ebdbb2",
      "editor.lineHighlightBackground": "#32302f",
      "editor.selectionBackground": "#504945",
      "editorLineNumber.foreground": "#7c6f64",
      "editorLineNumber.activeForeground": "#fabd2f",
      "editorGutter.background": "#282828",
      "diffEditor.insertedTextBackground": "#b8bb2625",
      "diffEditor.removedTextBackground": "#fb493425",
      "editorWidget.background": "#1d2021",
      "editorWidget.border": "#504945",
      "input.background": "#1d2021",
      "input.border": "#504945",
      "scrollbarSlider.background": "#50494580"
    }
  }
}
