FROM golang:1.24-alpine AS builder

# hadolint ignore=DL3018
RUN apk add --no-cache git

WORKDIR /src
ARG BUILD_COMMIT_DATE=
ARG BUILD_VERSION=
COPY go.mod go.sum* ./
RUN go mod download 2>/dev/null || true
COPY . .
RUN go mod tidy && CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w -X agentdeck/internal/buildinfo.CommitDate=${BUILD_COMMIT_DATE} -X agentdeck/internal/buildinfo.Version=${BUILD_VERSION}" -o /agentdeck ./cmd/agentdeck

FROM ubuntu:24.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl unzip ca-certificates git bash \
    libx11-xcb1 libxcb-dri3-0 libdrm2 libgbm1 libasound2t64 \
    libatk1.0-0 libatk-bridge2.0-0 libcups2 libgtk-3-0 \
    libpango-1.0-0 libcairo2 libnspr4 libnss3 libxcomposite1 \
    libxdamage1 libxfixes3 libxrandr2 libxshmfence1 libxkbcommon0 \
    libatspi2.0-0 libdbus-1-3 \
    libgl1 libegl1 libgles2 libgl1-mesa-dri \
    && rm -rf /var/lib/apt/lists/*

ENV ELECTRON_VERSION=34.5.8

RUN set -eux; \
    curl -L -o "/tmp/electron-v${ELECTRON_VERSION}-linux-x64.zip" \
    "https://github.com/electron/electron/releases/download/v${ELECTRON_VERSION}/electron-v${ELECTRON_VERSION}-linux-x64.zip"; \
    curl -L -o /tmp/SHASUMS256.txt \
    "https://github.com/electron/electron/releases/download/v${ELECTRON_VERSION}/SHASUMS256.txt"; \
    cd /tmp; \
    grep -E "^[0-9a-f]{64} [* ]electron-v${ELECTRON_VERSION}-linux-x64\\.zip$" SHASUMS256.txt > electron.sha256; \
    sha256sum -c electron.sha256; \
    mkdir -p /opt/electron; \
    cd /opt/electron; \
    unzip -qo "/tmp/electron-v${ELECTRON_VERSION}-linux-x64.zip"; \
    rm "/tmp/electron-v${ELECTRON_VERSION}-linux-x64.zip" /tmp/SHASUMS256.txt /tmp/electron.sha256; \
    chmod +x /opt/electron/electron

COPY --from=builder /agentdeck /app/agentdeck
COPY electron/main.js /app/main.js
COPY electron/preload.js /app/preload.js

WORKDIR /app
ENTRYPOINT ["/opt/electron/electron", "--no-sandbox", "--disable-gpu", "main.js"]
