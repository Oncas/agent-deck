{
  "id": "darcula-contrast",
  "name": "Darcula Contrast",
  "order": 32,
  "css": {
    "--bg": "#1e1f22",
    "--bg-sidebar": "#2b2d30",
    "--bg-panel": "#1e1f22",
    "--bg-hover": "#393b40",
    "--bg-secondary": "#2b2d30",
    "--bg-primary": "#1e1f22",
    "--border": "#393b40",
    "--text": "#a9b7c6",
    "--text-dim": "#98a0aa",
    "--accent": "#5aa9ff",
    "--green": "#6a8759",
    "--red": "#ff6b68",
    "--yellow": "#ffc66d",
    "--cyan": "#6897bb",
    "--magenta": "#9876aa"
  },
  "terminal": {
    "background": "#1e1f22",
    "foreground": "#a9b7c6",
    "cursor": "#a9b7c6",
    "selectionBackground": "#214283",
    "black": "#1e1f22",
    "red": "#ff6b68",
    "green": "#6a8759",
    "yellow": "#ffc66d",
    "blue": "#6897bb",
    "magenta": "#9876aa",
    "cyan": "#629755",
    "white": "#a9b7c6",
    "brightBlack": "#5a5d63",
    "brightRed": "#ff8785",
    "brightGreen": "#8fbc77",
    "brightYellow": "#ffd687",
    "brightBlue": "#80aacb",
    "brightMagenta": "#b393cc",
    "brightCyan": "#7fb872",
    "brightWhite": "#dfe1e5"
  },
  "monaco": {
    "base": "vs-dark",
    "inherit": true,
    "rules": [
      { "token": "comment", "foreground": "808080", "fontStyle": "italic" },
      { "token": "keyword", "foreground": "cc7832", "fontStyle": "bold" },
      { "token": "string", "foreground": "6a8759" },
      { "token": "number", "foreground": "6897bb" },
      { "token": "type", "foreground": "a9b7c6" },
      { "token": "function", "foreground": "ffc66d" },
      { "token": "variable", "foreground": "a9b7c6" },
      { "token": "variable.parameter", "foreground": "a9b7c6" },
      { "token": "constant", "foreground": "9876aa" },
      { "token": "operator", "foreground": "a9b7c6" },
      { "token": "tag", "foreground": "e8bf6a" },
      { "token": "attribute.name", "foreground": "bababa" }
    ],
    "colors": {
      "editor.background": "#1e1f22",
      "editor.foreground": "#a9b7c6",
      "editor.lineHighlightBackground": "#2b2d30",
      "editor.selectionBackground": "#214283",
      "editorLineNumber.foreground": "#4e5157",
      "editorLineNumber.activeForeground": "#9da0a8",
      "editorGutter.background": "#1e1f22",
      "diffEditor.insertedTextBackground": "#54915930",
      "diffEditor.removedTextBackground": "#ff6b6830",
      "editorWidget.background": "#2b2d30",
      "editorWidget.border": "#393b40",
      "input.background": "#2b2d30",
      "input.border": "#43454a",
      "scrollbarSlider.background": "#43454a80"
    }
  }
}
