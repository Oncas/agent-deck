{
  "id": "monokai-pro",
  "name": "Monokai Pro",
  "order": 33,
  "css": {
    "--bg": "#2d2a2e",
    "--bg-sidebar": "#221f22",
    "--bg-panel": "#2d2a2e",
    "--bg-hover": "#403e41",
    "--bg-secondary": "#353337",
    "--bg-primary": "#2d2a2e",
    "--border": "#5b595c",
    "--text": "#fcfcfa",
    "--text-dim": "#727072",
    "--accent": "#ff6188",
    "--green": "#a9dc76",
    "--red": "#ff6188",
    "--yellow": "#ffd866",
    "--cyan": "#78dce8",
    "--magenta": "#ab9df2"
  },
  "terminal": {
    "background": "#2d2a2e",
    "foreground": "#fcfcfa",
    "cursor": "#fcfcfa",
    "selectionBackground": "#5b595c",
    "black": "#403e41",
    "red": "#ff6188",
    "green": "#a9dc76",
    "yellow": "#ffd866",
    "blue": "#fc9867",
    "magenta": "#ab9df2",
    "cyan": "#78dce8",
    "white": "#fcfcfa",
    "brightBlack": "#727072",
    "brightRed": "#ff6188",
    "brightGreen": "#a9dc76",
    "brightYellow": "#ffd866",
    "brightBlue": "#fc9867",
    "brightMagenta": "#ab9df2",
    "brightCyan": "#78dce8",
    "brightWhite": "#fcfcfa"
  },
  "monaco": {
    "base": "vs-dark",
    "inherit": true,
    "rules": [
      { "token": "comment", "foreground": "727072", "fontStyle": "italic" },
      { "token": "keyword", "foreground": "ff6188" },
      { "token": "string", "foreground": "ffd866" },
      { "token": "number", "foreground": "ab9df2" },
      { "token": "type", "foreground": "78dce8", "fontStyle": "italic" },
      { "token": "function", "foreground": "a9dc76" },
      { "token": "variable", "foreground": "fcfcfa" },
      { "token": "variable.parameter", "foreground": "fc9867", "fontStyle": "italic" },
      { "token": "constant", "foreground": "ab9df2" },
      { "token": "operator", "foreground": "ff6188" },
      { "token": "tag", "foreground": "ff6188" },
      { "token": "attribute.name", "foreground": "a9dc76" }
    ],
    "colors": {
      "editor.background": "#2d2a2e",
      "editor.foreground": "#fcfcfa",
      "editor.lineHighlightBackground": "#353337",
      "editor.selectionBackground": "#5b595c",
      "editorLineNumber.foreground": "#5b595c",
      "editorLineNumber.activeForeground": "#c1c0c0",
      "editorGutter.background": "#2d2a2e",
      "diffEditor.insertedTextBackground": "#a9dc7625",
      "diffEditor.removedTextBackground": "#ff618825",
      "editorWidget.background": "#221f22",
      "editorWidget.border": "#5b595c",
      "input.background": "#221f22",
      "input.border": "#5b595c",
      "scrollbarSlider.background": "#5b595c80"
    }
  }
}
