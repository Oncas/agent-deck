{
  "id": "synthwave-84",
  "name": "Synthwave '84",
  "order": 34,
  "css": {
    "--bg": "#241b30",
    "--bg-sidebar": "#1a1530",
    "--bg-panel": "#241b30",
    "--bg-hover": "#34294f",
    "--bg-secondary": "#2a2139",
    "--bg-primary": "#241b30",
    "--border": "#495495",
    "--text": "#f4eee4",
    "--text-dim": "#848bbd",
    "--accent": "#ff7edb",
    "--green": "#72f1b8",
    "--red": "#fe4450",
    "--yellow": "#fede5d",
    "--cyan": "#36f9f6",
    "--magenta": "#ff7edb"
  },
  "terminal": {
    "background": "#241b30",
    "foreground": "#f4eee4",
    "cursor": "#ff7edb",
    "selectionBackground": "#463465",
    "black": "#1a1530",
    "red": "#fe4450",
    "green": "#72f1b8",
    "yellow": "#fede5d",
    "blue": "#36f9f6",
    "magenta": "#ff7edb",
    "cyan": "#03edf9",
    "white": "#f4eee4",
    "brightBlack": "#848bbd",
    "brightRed": "#ff5a6a",
    "brightGreen": "#82ffc9",
    "brightYellow": "#ffec73",
    "brightBlue": "#4cfffc",
    "brightMagenta": "#ff9be3",
    "brightCyan": "#5ffaff",
    "brightWhite": "#ffffff"
  },
  "monaco": {
    "base": "vs-dark",
    "inherit": true,
    "rules": [
      { "token": "comment", "foreground": "848bbd", "fontStyle": "italic" },
      { "token": "keyword", "foreground": "fede5d" },
      { "token": "string", "foreground": "ff8b39" },
      { "token": "number", "foreground": "f97e72" },
      { "token": "type", "foreground": "fe4450" },
      { "token": "function", "foreground": "36f9f6" },
      { "token": "variable", "foreground": "ff7edb" },
      { "token": "variable.parameter", "foreground": "f4eee4" },
      { "token": "constant", "foreground": "f97e72" },
      { "token": "operator", "foreground": "fede5d" },
      { "token": "tag", "foreground": "72f1b8" },
      { "token": "attribute.name", "foreground": "fede5d" }
    ],
    "colors": {
      "editor.background": "#241b30",
      "editor.foreground": "#f4eee4",
      "editor.lineHighlightBackground": "#2a2139",
      "editor.selectionBackground": "#463465",
      "editorLineNumber.foreground": "#495495",
      "editorLineNumber.activeForeground": "#ff7edb",
      "editorGutter.background": "#241b30",
      "diffEditor.insertedTextBackground": "#72f1b825",
      "diffEditor.removedTextBackground": "#fe445025",
      "editorWidget.background": "#1a1530",
      "editorWidget.border": "#495495",
      "input.background": "#1a1530",
      "input.border": "#495495",
      "scrollbarSlider.background": "#49549580"
    }
  }
}
